    "about.disclaimer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alert data is informational only. Do not rely on it for critical decisions."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные тревог носят информационный характер. Не полагайтесь на них при критических решениях."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані тривог мають інформаційний характер. Не покладайтеся на них при критичних рішеннях."
          }
        }
      },
      "comment" : "Details: the About footer. REQ-PROVIDER-003 wording contract; kept in full (owner, 2026-11-10). UI-simplify AC-8."
    },
    "about.pro.liveActivity.caption" : {
      "comment" : "Details: footer of the Alerts section, under the Live Activities switch. One sentence. UI-simplify AC-6.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the alert on the Lock Screen and in the Dynamic Island until the all-clear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает тревогу на экране блокировки и в Dynamic Island до отбоя."
