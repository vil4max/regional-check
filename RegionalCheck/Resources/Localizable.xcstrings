      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drive Check shows air-raid alert status for Ukrainian regions — built for drivers and CarPlay. Pick a region or follow your location while you drive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drive Check показывает статус воздушной тревоги по регионам Украины — для водителей и CarPlay. Выберите регион или следуйте за геолокацией в пути."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drive Check показує статус повітряної тривоги по регіонах України — для водіїв і CarPlay. Оберіть регіон або слідкуйте за геолокацією в дорозі."
          }
        }
      }
