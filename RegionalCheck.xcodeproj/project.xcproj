{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "ru",
      "uk",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Packages/DriveCheckKit",
    }, {
      "kind": "remote",
      "repository": "https://github.com/BarredEwe/Prefire",
      "version": {
        "up-to-next-major-version": "5.8.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-snapshot-testing",
      "version": {
        "up-to-next-major-version": "1.19.5",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "RegionalCheck",
      "target-membership": [
        "RegionalCheck",
      ],
      "membership-exceptions": [
        {
          "target": "RegionalCheck",
          "exclusions": [
            "Resources/Info.plist",
            "Resources/PrivacyInfo.xcprivacy",
            "Resources/Products.storekit",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "RegionalCheckTests", "target-membership": [ "RegionalCheckTests" ] },
    {
      "kind": "folder",
      "path": "RegionalCheckWidgets",
      "target-membership": [
        "RegionalCheckWidgets",
      ],
      "membership-exceptions": [
        {
          "target": "RegionalCheckWidgets",
          "exclusions": [
            "Info.plist",
            "PrivacyInfo.xcprivacy",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/RegionalCheck.app", "id": "509E636E2E5EE1BF00A13E04", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/RegionalCheckTests.xctest", "id": "509E637F2E5EE1C000A13E04", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/RegionalCheckWidgets.appex", "id": "A1B2C3D40E5EE00100WIDGET", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "RegionalCheck/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "RegionalCheck",
      "id": "509E636D2E5EE1BF00A13E04",
      "product": "Products/RegionalCheck.app",
      "product-type": "application",
      "dependencies": [
        "RegionalCheckWidgets",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "package": "DriveCheckKit",
          "product-name": "DriveCheckKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_ALTERNATE_APPICON_NAMES": "AppIcon-Pro",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "YES",
        "CODE_SIGN_ENTITLEMENTS": "RegionalCheck/Resources/RegionalCheck.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "4",
        "DEVELOPMENT_TEAM": "BTHRDS7254",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "RegionalCheck/Resources/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Drive Check",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_NSSupportsLiveActivities": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "NO",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "NO",
        "INFOPLIST_KEY_UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "MARKETING_VERSION": "3.1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "vil4max.RegionalCheck",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    }, {
      "name": "RegionalCheckTests",
      "id": "509E637E2E5EE1C000A13E04",
      "product": "Products/RegionalCheckTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "RegionalCheck",
      "dependencies": [
        "RegionalCheck",
        { "kind": "package", "package": "Prefire", "product-name": "PrefireTestsPlugin", "product-type": "build-tool-plugin" },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "DriveCheckKit",
          "product-name": "DriveCheckKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Prefire",
          "product-name": "Prefire",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-snapshot-testing",
          "product-name": "SnapshotTesting",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "4",
        "DEVELOPMENT_TEAM": "BTHRDS7254",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
        "MARKETING_VERSION": "3.1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "vil4max.RegionalCheckTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/RegionalCheck.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/RegionalCheck",
      },
    }, {
      "name": "RegionalCheckWidgets",
      "id": "A1B2C3D40E5EE00200WIDGET",
      "product": "Products/RegionalCheckWidgets.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "DriveCheckKit",
          "product-name": "DriveCheckKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "RegionalCheckWidgets/RegionalCheckWidgets.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "4",
        "DEVELOPMENT_TEAM": "BTHRDS7254",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "RegionalCheckWidgets/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Drive Check",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "3.1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "vil4max.RegionalCheck.widgets",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ARCHS": "arm64",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "BTHRDS7254",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "16.4",
}
