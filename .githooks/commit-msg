#!/usr/bin/env bash
set -euo pipefail

MESSAGE_FILE="$1"
SUBJECT="$(head -n 1 "$MESSAGE_FILE")"
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9,._/-]*\))?!?: .+'

if [[ "$SUBJECT" == Merge\ * ]]; then
  exit 0
fi

if ! printf '%s\n' "$SUBJECT" | grep -Eq "$PATTERN"; then
  cat >&2 <<'EOF'
Invalid commit subject. Use Conventional Commits:
  type(scope): imperative summary

Allowed types:
  feat fix docs style refactor perf test build ci chore revert

Examples:
  fix(data): parse alert timestamps in Kyiv time
  chore(release): bump version to 2.1
EOF
  exit 1
fi
